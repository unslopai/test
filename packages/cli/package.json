{
  "name": "@unslopcodes/cli",
  "version": "0.1.0",
  "description": "Anti-AI-Slop Gatekeeper CLI — scan your local diff against the connected repository's rules.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "unslop": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --log-level=warning && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts"
  },
  "devDependencies": {
    "@unslop/shared": "0.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
