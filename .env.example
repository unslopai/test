# Unslop — Environment-Variablen (Referenz; echte Werte in .env.local, nie committen)

# --- Google Vertex AI (VERTEX-001: ADC via Base64 → Temp-JSON) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_BASE64=

# --- Vertex Explicit Context Cache (PROMPT_CACHING_SPEC.md) ---
# Kill-Switch: '1' erzwingt den Inline-Prompt-Pfad für ALLE Repos (D10).
# Unset/leer = Caching aktiv (Default ON).
VERTEX_CONTEXT_CACHE_DISABLED=
# Sliding-TTL in Sekunden (Default 3600; Bump bei < halber Restlaufzeit, D9).
VERTEX_CACHE_TTL_SECONDS=

# --- Supabase (INFRA-001: eine REMOTE-Datenbank, ref ypjgdqkrsnetiiosspix) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Operator (OPERATOR_SETTINGS_SPEC.md §3.7) ---
# Kommagetrennte Supabase-Auth-UUIDs mit Zugriff auf die operator-only
# Pipeline-Settings (Seite + API). Fail-closed: leer/unset = Fläche für ALLE
# gesperrt, auch für den Operator.
OPERATOR_USER_IDS=

# --- App ---
# Öffentlicher Origin — Quelle für Billing-Redirects, PR-Kommentar-Links, Canonicals.
APP_BASE_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
WEBHOOK_BASE_URL=
# Shared Secret für interne Service-Calls: `x-internal-secret` auf
# POST /api/internal/prescan (Pre-Scanner-Standalone-Invocation, ROADMAP §1b).
# Fail-closed: unset ⇒ Route 503 UND der Worker-Step degradiert (kein Prescan).
WORKER_INTERNAL_SECRET=

# --- GitHub App (GITHUB_APP_SPEC.md) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# --- Paddle Billing (PADDLE_SPEC.md §14.2) ---
# Server-API-Key (sandbox: pdl_sdbx_…, live: pdl_live_…)
PADDLE_API_KEY=
# Secret der Notification-Destination (Paddle generiert es beim Anlegen, §3.5)
PADDLE_WEBHOOK_SECRET=
# Client-Token für Paddle.js (public by design)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# 'sandbox' | 'production'
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Die beiden Pro-Prices (€29/Monat): mit 14-Tage-Trial und ohne (§3.3)
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_MONTHLY_TRIAL=

# --- Waitlist (WAITLIST_SPEC.md) ---
# 'true' schaltet Formular + POST /api/waitlist scharf. Erst am HR-Eintragungstag
# zusammen mit den Rechtsseiten setzen (§7); unset = Landing Page unverändert, Route 404.
NEXT_PUBLIC_WAITLIST_LIVE=
# Brevo (EU-gehostet, DOI-Endpoint). Fehlt eine Variable bei Flag 'true' ⇒ 503.
BREVO_API_KEY=
BREVO_WAITLIST_LIST_ID=
BREVO_DOI_TEMPLATE_ID_EN=
BREVO_DOI_TEMPLATE_ID_DE=
# Geheimer Salt für den tagesrotierenden IP-Hash des Rate-Limits (§4.4).
WAITLIST_IP_SALT=
