+export function formatRelativeDays(isoTimestamp: string, referenceDate: Date): string {
+    const elapsedMs = referenceDate.getTime() - new Date(isoTimestamp).getTime();
+    const elapsedDays = Math.floor(elapsedMs / MILLISECONDS_PER_DAY);
+
+    if (elapsedDays <= 0) return 'today';
+    if (elapsedDays === 1) return 'yesterday';
+    return new Intl.RelativeTimeFormat('en').format(-elapsedDays, 'day');
+}
