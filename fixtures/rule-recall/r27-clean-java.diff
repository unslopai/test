+package com.acme.reports;
+
+import java.io.BufferedReader;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+public class ReportArchiveReader {
+    private static final Logger LOGGER = LoggerFactory.getLogger(ReportArchiveReader.class);
+    private static final int MAX_HEADER_LINES = 20;
+
+    public List<String> readHeaderLines(Path reportPath) throws ReportUnavailableException {
+        try (BufferedReader reportReader = Files.newBufferedReader(reportPath, StandardCharsets.UTF_8)) {
+            return reportReader.lines().limit(MAX_HEADER_LINES).toList();
+        } catch (IOException readFailure) {
+            LOGGER.error("Report header of {} could not be read", reportPath, readFailure);
+            throw new ReportUnavailableException(reportPath, readFailure);
+        }
+    }
+
+    public static class ReportUnavailableException extends Exception {
+        public ReportUnavailableException(Path reportPath, IOException cause) {
+            super("Report unavailable: " + reportPath, cause);
+        }
+    }
+}
