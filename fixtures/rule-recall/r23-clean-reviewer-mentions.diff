+import { issueSigningKey, retireSigningKey } from './key-store';
+
+// Review policy: security-sensitive edits to this module require an explicit sign-off
+// from a second reviewer drawn from the security guild, in addition to the code owner.
+export async function rotateSigningKey(tenantId: string): Promise<string> {
+    const nextKeyId = await issueSigningKey(tenantId);
+    try {
+        await retireSigningKey(tenantId);
+    } catch (retireError: unknown) {
+        console.error(`Retiring the previous signing key for tenant ${tenantId} failed:`, retireError);
+        throw retireError;
+    }
+    return nextKeyId;
+}

