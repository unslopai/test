+/**
+ * Human code-review checklist shown in the merge dialog.
+ * Reviewers confirm each item before approving a pull request;
+ * the list is rendered verbatim and is not evaluated by any tool.
+ */
+export const MERGE_CHECKLIST_ITEMS: readonly string[] = [
+    'Tests cover the changed behavior.',
+    'Public API changes are documented.',
+    'Migrations are reversible or have a rollback note.',
+];
+
+export function isChecklistComplete(confirmedItemCount: number): boolean {
+    return confirmedItemCount === MERGE_CHECKLIST_ITEMS.length;
+}
