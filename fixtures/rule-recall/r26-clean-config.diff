=== FILE: infra/storage/report-archive.tf (modified) ===
@@ -1,0 +1,21 @@
+resource "aws_s3_bucket" "report_archive" {
+  bucket = "acme-report-archive"
+}
+
+resource "aws_s3_bucket_public_access_block" "report_archive" {
+  bucket                  = aws_s3_bucket.report_archive.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_server_side_encryption_configuration" "report_archive" {
+  bucket = aws_s3_bucket.report_archive.id
+
+  rule {
+    apply_server_side_encryption_by_default {
+      sse_algorithm = "aws:kms"
+    }
+  }
+}

